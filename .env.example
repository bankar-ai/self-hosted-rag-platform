# Required. Signs/verifies JWT access tokens (see app/auth/config.py's AuthSettings).
# No default is provided anywhere in the app -- it must be set explicitly, in every
# environment (including local dev and CI), so a signing secret is never accidentally
# hardcoded or shared across deployments. Generate a real, random secret for production,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_JWT_SECRET_KEY=

# Optional (ERP-116). Controls the access/refresh/CSRF cookie attributes. Defaults to "true"
# (Secure=True, SameSite=None) -- required in production, where the frontend (Vercel) and this
# API are different origins: SameSite=None is the only setting a real cross-origin browser
# request will attach the cookie under at all, and Secure is mandatory for SameSite=None.
# Set to "false" ONLY for local plain-http:// dev (no HTTPS), which switches to
# Secure=False/SameSite=Lax instead -- a Secure cookie is never sent back over plain HTTP.
# AUTH_COOKIE_SECURE=true

# Optional, but effectively required for a real deployment (see app/core/cors.py's
# CorsSettings). Comma-separated list of origins the browser frontend may call this API from --
# defaults to Vite's local dev server only. Since ERP-116, this MUST be an explicit origin list,
# never "*" -- the CORS spec forbids combining a wildcard origin with credentialed requests
# (allow_credentials=True, required so the browser sends/receives the httpOnly auth cookies),
# and CORSMiddleware enforces that at the browser level regardless of this app's own config.
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional, but effectively required for a real deployment. Ollama only resolves an untagged
# model name (e.g. "qwen3") to an implicit ":latest" tag -- it does NOT fall back to whatever
# tag you actually pulled (e.g. "qwen3:8b"). If these don't match a tag installed on the target
# Ollama host exactly, generation/embedding calls fail on the first real request with a
# "model not found" error. Verify with `ollama list` on that host, or run
# `uv run python -m app.core.check_models` to check both at once before deploying. See
# ERP-035 (docs/deployment.md, once written) for hardware/VRAM sizing guidance per model.
# GENERATION_MODEL=qwen3:8b
# EMBEDDING_MODEL=nomic-embed-text:latest

# Optional (ERP-106). GENERATION_PROVIDER defaults to "ollama" (self-hosted/Modal-backed,
# unchanged behavior) -- set to "openrouter" to route generation to OpenRouter's always-on
# hosted infrastructure instead (no cold start, but a real per-token cost; see docs/deployment.md).
# GENERATION_OPENROUTER_API_KEY is required when GENERATION_PROVIDER=openrouter.
# GENERATION_PROVIDER=openrouter
# GENERATION_OPENROUTER_API_KEY=
# GENERATION_OPENROUTER_MODEL=google/gemma-3-27b-it

# Optional (ERP-108). Per-user, per-minute rate limit on /generation/query,
# /generation/query/stream, and /retrieval/query -- every real generation call costs actual
# money (Modal/OpenRouter), so this bounds cost exposure from a single account looping calls.
# Backed by Redis (reuses the same instance as the embedding/retrieval caches by default);
# fails open (allows the request) if Redis is unreachable, logged as a warning.
# RATE_LIMIT_REQUESTS_PER_MINUTE=20
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Optional. OIDC login (ERP-032), additive to local email/password login above -- leave all
# four unset (the default) to leave /auth/oidc/* endpoints disabled (404) with no other
# behavior change. Provider-agnostic: point these at Google, Microsoft Entra ID, Okta, or a
# self-hosted Keycloak/Authentik -- everything provider-specific is resolved at request time
# from AUTH_OIDC_ISSUER's `.well-known/openid-configuration` discovery document, never
# hardcoded. AUTH_OIDC_PROVIDER_NAME is only the URL path segment (e.g. /auth/oidc/google/login)
# and defaults to "google", this repo's reference/test provider.
# AUTH_OIDC_PROVIDER_NAME=google
# AUTH_OIDC_ISSUER=https://accounts.google.com
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/google/callback

# Optional. Where hand-written + auto-instrumented OTel traces (ERP-028) are exported. These are
# OTel's own standard env vars, not app-prefixed like the rest of this file. Unset (the default)
# exports via gRPC to http://localhost:4317, matching docker-compose.yml's local Jaeger service --
# fine for local dev, but the live deployment has no local collector to send to (ERP-037's VM has
# no RAM headroom to run one), so it points at Grafana Cloud's free tier instead (ERP-038):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64(instance_id:api_token)>
# Note the literal space in "Basic <token>" must be percent-encoded as "Basic%20" here --
# Python's OTel SDK splits OTEL_EXPORTER_OTLP_HEADERS on raw spaces, breaking the header
# otherwise. See docs/deployment.md's "Traces" section for how to get these values and where to
# look at the resulting traces.

# Optional (ERP-112). LLM-level tracing via Langfuse Cloud -- prompt/response/token detail per
# generation call, complementary to the app-wide OTel traces above, not a replacement. These are
# Langfuse's own standard env var names, not app-prefixed. Leave all three unset (the default) to
# leave generation tracing off with no other behavior change -- every call site degrades to a
# no-op rather than raising. Sign up for the free Hobby tier at https://cloud.langfuse.com,
# create a project, and get these from Project Settings -> API Keys. LANGFUSE_BASE_URL depends
# on the data region chosen at signup (US shown below; EU is https://cloud.langfuse.com).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
